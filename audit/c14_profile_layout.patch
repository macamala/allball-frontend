diff --git a/src/styles/entityProfiles.css b/src/styles/entityProfiles.css
new file mode 100644
index 0000000..f30531d
--- /dev/null
+++ b/src/styles/entityProfiles.css
@@ -0,0 +1,78 @@
+/* Shared, scoped team/player language: no global score or news overrides. */
+.page-main > .entity-page {
+  width: min(1100px, 100%);
+  margin: 0 auto;
+  min-width: 0;
+  padding: 22px 0 32px;
+}
+.entity-page a { color: inherit; text-decoration: none; }
+.entity-page a:hover { color: #70b7ff; }
+.entity-page a:focus-visible { outline: 2px solid #58a6ff; outline-offset: 4px; border-radius: 4px; }
+.entity-page .entity-back { display: inline-flex; align-items: center; min-height: 40px; font-size: .82rem; color: #a9bfd9; margin-bottom: 12px; }
+.entity-page .entity-hero { display: flex; align-items: center; gap: 22px; padding: 24px; background: #0b2036; border: 1px solid #29455f; border-radius: 14px; min-width: 0; }
+.entity-page .entity-hero > div { min-width: 0; }
+.entity-page .entity-hero h1 { font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.18; margin: 6px 0 10px; overflow-wrap: anywhere; }
+.entity-page .entity-hero .kicker { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: #9ab5d4; margin: 0; }
+.entity-page .entity-profile-logo { width: 100px; height: 100px; flex: 0 0 100px; object-fit: contain; }
+.entity-page .entity-profile-logo.is-player { border-radius: 12px; background: #102b45; object-fit: contain; object-position: bottom; }
+.entity-page .entity-profile-logo.is-fallback { display: grid; place-items: center; font-size: 2rem; color: #9ec9f7; }
+.entity-page .entity-subline { display: flex; flex-wrap: wrap; gap: 10px; color: #abc1da; font-size: .85rem; }
+.entity-page .entity-grid { display: grid; grid-template-columns: minmax(0, 1fr) 304px; align-items: start; gap: 20px; margin-top: 20px; }
+.entity-page .entity-grid > * { min-width: 0; display: grid; gap: 20px; }
+.entity-page .entity-card { min-width: 0; overflow: hidden; border: 1px solid #29455f; border-radius: 12px; background: #091c30; }
+.entity-page .entity-card-head { padding: 15px 18px; border-bottom: 1px solid #29455f; background: #0e263f; }
+.entity-page .entity-card-head h2 { margin: 0; font-size: .94rem; line-height: 1.4; }
+.entity-page .entity-card > p { color: #a9bfd9; font-size: .78rem; line-height: 1.55; margin: 12px 18px; }
+.entity-page .entity-loading { padding: 24px; color: #a9bfd9; }
+.entity-page .entity-facts { display: grid; gap: 0; margin: 0; padding: 4px 18px 10px; }
+.entity-page .entity-facts > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; padding: 11px 0; border-bottom: 1px solid #1b354e; font-size: .83rem; }
+.entity-page .entity-facts > div:last-child { border: 0; }
+.entity-page .entity-facts dt { color: #9eb7d1; }
+.entity-page .entity-facts dd { margin: 0; text-align: right; overflow-wrap: anywhere; font-weight: 600; }
+.entity-page .entity-match-row { display: grid; gap: 10px; padding: 15px 18px; border-bottom: 1px solid #1b354e; }
+.entity-page .entity-match-row:last-child { border: 0; }
+.entity-page .entity-match-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; color: #9eb7d1; font-size: .7rem; }
+.entity-page .entity-match-meta small { font-size: inherit; }
+.entity-page .entity-match-pair { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: center; font-size: .84rem; }
+.entity-page .entity-match-pair > span { overflow-wrap: anywhere; }
+.entity-page .entity-match-pair > span:last-child { text-align: right; }
+.entity-page .entity-match-pair > strong { font-variant-numeric: tabular-nums; font-size: 1rem; white-space: nowrap; }
+.entity-page .entity-form { display: flex; gap: 5px; margin-top: 12px; }
+.entity-page .entity-form > span { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 5px; background: #28445f; font-size: .75rem; }
+.entity-page .entity-form .is-w { background: #166456; }
+.entity-page .entity-form .is-l { background: #8a3447; }
+.entity-page .entity-badge { display: inline-block; margin-top: 8px; padding: 4px 8px; border: 1px solid #436079; border-radius: 5px; font-size: .72rem; }
+.entity-page .player-summary { display: grid; grid-template-columns: minmax(0, 1fr) 304px; gap: 20px; align-items: stretch; }
+.entity-page .player-value-card { display: flex; flex-direction: column; justify-content: center; }
+.entity-page .player-value-card > strong { padding: 12px 18px 0; font-size: 2rem; font-variant-numeric: tabular-nums; color: #e8f3ff; }
+.entity-page .player-value-card > p { padding: 0; font-size: .73rem; }
+.entity-page .player-club-link { font-size: .9rem; line-height: 1.45; }
+.entity-page .player-season-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 18px; gap: 18px 12px; }
+.entity-page .player-season-grid dt { font-size: .72rem; line-height: 1.4; }
+.entity-page .player-season-grid dd { font-size: 1.45rem; font-variant-numeric: tabular-nums; }
+.entity-page .player-career { padding: 0 18px; }
+.entity-page .player-career li a { font-size: .86rem; font-weight: 600; }
+.entity-page .player-career li:first-child a { color: #75d6c5; }
+.entity-page .player-career li > div { min-width: 0; overflow-wrap: anywhere; }
+@media (max-width: 760px) {
+  .page-main > .entity-page { padding-top: 10px; }
+  .entity-page .entity-grid, .entity-page .player-summary { grid-template-columns: minmax(0, 1fr); gap: 14px; }
+  .entity-page .entity-grid { margin-top: 14px; }
+  .entity-page .entity-grid > * { gap: 14px; }
+  .entity-page .entity-hero { padding: 18px 14px; gap: 14px; }
+  .entity-page .entity-profile-logo { width: 76px; height: 88px; flex-basis: 76px; }
+  .entity-page .entity-hero h1 { font-size: 1.6rem; }
+  .entity-page .entity-card-head { padding: 13px 14px; }
+  .entity-page .player-value-card > strong { font-size: 1.85rem; padding-top: 10px; }
+  .entity-page .player-value-card > p { margin-top: 6px; }
+  .entity-page .player-season-grid { padding: 16px 14px; gap: 16px 10px; }
+  .entity-page .player-season-grid dd { font-size: 1.25rem; }
+  .entity-page .entity-match-row { padding: 14px; }
+  .entity-page .entity-match-pair { gap: 8px; font-size: .8rem; }
+  .entity-page .player-career { padding: 0 14px; }
+}
+@media (max-width: 350px) {
+  .entity-page .player-season-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .entity-page .entity-hero h1 { font-size: 1.4rem; }
+  .entity-page .player-club-link { font-size: .8rem; }
+}
